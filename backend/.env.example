# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backstreet_dogs
DB_USER=postgres
DB_PASSWORD=your_password

# Blockchain Configuration
RPC_URL=http://localhost:8545
CHAIN_ID=1337

# Contract Addresses (updated after deployment)
BSD_TOKEN_ADDRESS=
MUSIC_NFT_ADDRESS=
STREAMING_ACCESS_ADDRESS=
MARKETPLACE_ADDRESS=

# IPFS Configuration
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRATION=7d

# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_PATH=./uploads
